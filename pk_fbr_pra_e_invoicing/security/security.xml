<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pakistan_compliance" model="ir.module.category">
        <field name="name">Pakistan Compliance</field>
        <field name="description">Manage FBR/PRA e-invoicing compliance settings</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_pakistan_compliance_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_pakistan_compliance"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_pakistan_compliance_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_pakistan_compliance"/>
        <field name="implied_ids" eval="[(4, ref('group_pakistan_compliance_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="fbr_queue_rule_user" model="ir.rule">
        <field name="name">FBR/PRA Queue: see own company's records</field>
        <field name="model_id" ref="model_fbr_queue"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pakistan_compliance_user'))]"/>
    </record>

    <record id="fbr_log_rule_user" model="ir.rule">
        <field name="name">FBR/PRA Log: see own company's records</field>
        <field name="model_id" ref="model_fbr_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pakistan_compliance_user'))]"/>
    </record>
</odoo>
