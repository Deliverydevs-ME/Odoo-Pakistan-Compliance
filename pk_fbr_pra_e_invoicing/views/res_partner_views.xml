<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_pakistan_compliance" model="ir.ui.view">
        <field name="name">res.partner.form.pakistan.compliance</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="FBR / PRA" name="fbr_pra_compliance">
                    <group>
                        <group>
                            <field name="fbr_customer_category"/>
                            <field name="fbr_province_id"/>
                            <field name="fbr_contact_person"/>
                        </group>
                        <group>
                            <field name="fbr_ntn"/>
                            <field name="fbr_stn"/>
                            <field name="fbr_nic"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
