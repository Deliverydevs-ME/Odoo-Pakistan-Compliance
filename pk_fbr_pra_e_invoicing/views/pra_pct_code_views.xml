<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pra_pct_code_list" model="ir.ui.view">
        <field name="name">pra.pct.code.list</field>
        <field name="model">pra.pct.code</field>
        <field name="arch" type="xml">
            <list>
                <field name="code_number"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_pra_pct_code_form" model="ir.ui.view">
        <field name="name">pra.pct.code.form</field>
        <field name="model">pra.pct.code</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code_number"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pra_pct_code_search" model="ir.ui.view">
        <field name="name">pra.pct.code.search</field>
        <field name="model">pra.pct.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="code_number"/>
                <field name="description"/>
            </search>
        </field>
    </record>

    <record id="action_pra_pct_code" model="ir.actions.act_window">
        <field name="name">PRA PCT Codes</field>
        <field name="res_model">pra.pct.code</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
