<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_pra_sales_invoice" model="ir.actions.report">
        <field name="name">PRA Sales Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_pk_fbr_einvoicing.report_pra_sales_invoice_document</field>
        <field name="report_file">l10n_pk_fbr_einvoicing.report_pra_sales_invoice_document</field>
        <field name="print_report_name">'PRA Sales Invoice - %s' % (object.name)</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_pra_sales_invoice_document">
        <t t-call="web.html_container">
            <t t-foreach="docs.sudo()" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>SALES TAX INVOICE</h2>
                        <div class="row">
                            <div class="col-6">
                                <strong>Buyer:</strong>
                                <p t-field="o.partner_id.name"/>
                                <p t-field="o.partner_id.fbr_ntn"/>
                                <p t-field="o.partner_id.fbr_nic"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Invoice No:</strong> <span t-field="o.name"/><br/>
                                <strong>Date:</strong> <span t-field="o.invoice_date"/>
                            </div>
                        </div>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Price</th>
                                    <th class="text-end">Value Excl. Tax</th>
                                    <th class="text-end">Tax Rate</th>
                                    <th class="text-end">Tax Amount</th>
                                    <th class="text-end">Value Incl. Tax</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.invoice_line_ids.filtered(lambda l: l.display_type == 'product')" t-as="line">
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                    <td class="text-end"><span t-field="line.price_subtotal"/></td>
                                    <td class="text-end"><span t-field="line.fbr_tax_rate"/>%</td>
                                    <td class="text-end"><span t-field="line.fbr_tax_amount"/></td>
                                    <td class="text-end"><span t-esc="line.price_subtotal + line.fbr_tax_amount"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="text-muted small">
                            Income tax withheld under Section 153 of the Income Tax Ordinance, 2001, where applicable.
                        </p>
                        <div t-if="o.pra_invoice_number and o.pra_datetime and o.pra_status">
                            <strong>PRA Invoice No:</strong> <span t-field="o.pra_invoice_number"/>
                            <div t-field="o.pra_invoice_number"
                                 t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 120, 'height': 120}"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
