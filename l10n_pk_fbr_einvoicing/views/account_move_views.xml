<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_pakistan_compliance" model="ir.ui.view">
        <field name="name">account.move.form.pakistan.compliance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_post_to_fbr" type="object" string="Post to FBR"
                        class="btn-secondary"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund') or not fbr_submit_to_fbr or not company_id.fbr_enabled"/>
                <button name="action_post_to_pra" type="object" string="Post to PRA"
                        class="btn-secondary"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund') or not submit_to_pra or not company_id.pra_enabled"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="FBR / PRA" name="fbr_pra_compliance"
                      invisible="move_type not in ('out_invoice', 'out_refund') or (not company_id.fbr_enabled and not company_id.pra_enabled)">
                    <group>
                        <group string="FBR">
                            <field name="fbr_submit_to_fbr"/>
                            <field name="fbr_is_pos_origin" readonly="1"/>
                            <field name="fbr_status" readonly="1"/>
                            <field name="fbr_invoice_number" readonly="1"/>
                            <field name="fbr_datetime" readonly="1"/>
                            <field name="fbr_response" readonly="1" widget="text"/>
                        </group>
                        <group string="PRA">
                            <field name="submit_to_pra"/>
                            <field name="pra_payment_mode"/>
                            <field name="pra_status" readonly="1"/>
                            <field name="pra_invoice_number" readonly="1"/>
                            <field name="pra_datetime" readonly="1"/>
                            <field name="pra_response" readonly="1" widget="text"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='quantity']" position="after">
                <field name="fbr_hs_code" optional="show"/>
                <field name="fbr_sale_type_id" optional="show"/>
                <field name="pra_pct_code_id" optional="show"/>
                <field name="fbr_tax_rate" optional="hide"/>
                <field name="fbr_tax_amount" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_pakistan_compliance" model="ir.ui.view">
        <field name="name">account.move.list.pakistan.compliance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button name="action_bulk_submit_to_fbr" type="object" string="Submit to FBR"/>
                <button name="action_bulk_submit_to_pra" type="object" string="Submit to PRA"/>
            </xpath>
        </field>
    </record>
</odoo>
